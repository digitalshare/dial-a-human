# Vapi keys. If VAPI_API_PRIVATE_KEY / VAPI_API_PUBLIC_KEY are already exported in your shell, you can skip these.
VAPI_API_PRIVATE_KEY=
VAPI_API_PUBLIC_KEY=

# Real phone call (optional). Needs a number imported into Vapi from Twilio/Telnyx/Vonage;
# free Vapi numbers cannot place outbound calls. Without these the robot calls you in the browser.
VAPI_PHONE_NUMBER_ID=
OPERATOR_PHONE=

# Force a mode: web | phone (default: phone when the two values above are set, else web)
CALL_MODE=

# Leave empty to let the server open a cloudflared quick tunnel by itself.
PUBLIC_URL=
